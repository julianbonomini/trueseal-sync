    "removed",
    "destroyed",
    "storeReset"
  ],
  "statuses": [
    "notJoined",
    "pendingJoin",
    "member",
    "leaving",
    "destroying"
  ],
  "connectionStates": [
    "connecting",
    "connected",
    "disconnected",
